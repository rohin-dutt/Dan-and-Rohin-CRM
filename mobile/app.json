{
  "expo": {
    "name": "Roots",
    "slug": "roots",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "roots",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0EBE1"
    },
    "ios": {
      "bundleIdentifier": "com.roots.crm",
      "supportsTablet": false,
      "buildNumber": "2026060201",
      "infoPlist": {
        "NSContactsUsageDescription": "Roots needs access to your contacts so you can import only the people you choose.",
        "NSUserNotificationsUsageDescription": "Roots uses notifications for privacy-safe follow-up and birthday reminders."
      },
      "privacyManifests": {
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": []
      }
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-contacts",
        {
          "contactsPermission": "Roots needs access to your contacts so you can import the people you want to stay close to."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7C9A7E"
        }
      ]
    ]
  }
}
